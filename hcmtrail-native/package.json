{
  "name": "hcmtrail-native-oracle-lab",
  "version": "0.1.0",
  "description": "Four native STARK vaults, STARK-authorized HCMT staking, and standalone Chainlink epochs; testnet only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/compile.mjs",
    "test": "node --test test/oracle.test.mjs",
    "test:tvm": "node --test test/oracle.tvm.test.mjs",
    "build:vault": "node scripts/build-vault.mjs",
    "test:vault": "node --test test/vault.test.mjs",
    "test:vault:tvm": "node --test test/vault.tvm.test.mjs",
    "demo": "node scripts/local-demo.mjs",
    "test:stark": "bash scripts/test-stark-reference.sh",
    "bundle": "bash scripts/bundle-source.sh",
    "testnet": "node scripts/testnet.mjs",
    "build:testnet": "node scripts/build-vault.mjs --testnet",
    "test:testnet": "node --test --test-concurrency=1 test/testnet.test.mjs",
    "test:testnet:fresh": "node --test --test-concurrency=1 test/testnet-fresh.test.mjs",
    "build:dao": "node scripts/build-vault.mjs --dao",
    "test:dao": "node --test --test-concurrency=1 test/dao.test.mjs",
    "test:dao:fresh": "node --test --test-concurrency=1 test/dao-fresh.test.mjs",
    "test:stake": "node --test --test-concurrency=1 test/staking.test.mjs",
    "test:stake:fresh": "NATIVE_STAKE_GENERATE=1 node --test --test-concurrency=1 test/staking.test.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/edr": "0.25.1",
    "@tvmjs/common": "1.2.0",
    "@tvmjs/tvm": "1.2.0",
    "@tvmjs/util": "1.2.0",
    "ethers": "6.17.0",
    "solc": "0.8.24",
    "tronweb": "6.5.1"
  },
  "overrides": {
    "tmp": "0.2.7",
    "tronweb": {
      "axios": "1.20.0"
    }
  }
}
