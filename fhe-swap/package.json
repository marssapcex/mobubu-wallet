{
  "name": "fhe-swap",
  "version": "0.2.0",
  "description": "NYX-hub native cross-chain swap reference: sealed orderflow, streaming subswaps, arb rebalancing, threshold vault settlement for BTC, ETH, XMR, ZEC, DAI. Inspired by THORChain and Serai/monero-oxide.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "demo": "npm run build && node dist/src/cli-streaming.js",
    "demo:bfv": "npm run build && node dist/src/cli.js",
    "fetch:upstreams": "bash scripts/fetch-upstreams.sh"
  },
  "keywords": [
    "fhe",
    "homomorphic-encryption",
    "cross-chain",
    "swap",
    "thorchain",
    "serai",
    "bitcoin",
    "ethereum",
    "monero",
    "zcash",
    "dai",
    "privacy"
  ],
  "license": "MIT",
  "dependencies": {
    "node-seal": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
